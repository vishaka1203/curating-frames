# Set to the real HTTPS origin before launch (no trailing slash).
NEXT_PUBLIC_SITE_URL=
# Resend API key and a verified sender domain are required for online enquiries.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=curatingframes@gmail.com

# Verified studio Facebook page URL (optional).
NEXT_PUBLIC_FACEBOOK_URL=

# Shared visit counter. Use a dedicated Curating Frames database, not another site's database.
MONGODB_URI=
# Random server-only secret, at least 32 characters. Never prefix with NEXT_PUBLIC_.
VISITS_COOKIE_SECRET=
